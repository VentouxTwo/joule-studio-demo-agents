{
  "openapi": "3.0.2",
  "info": {
    "title": "SAP Task Center Service Provider Interface",
    "description": "SAP Advanced Financial Closing provides a public API exposing Task Center Service Provider Interface.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/api/task-provider/v2"
    }
  ],
  "security": [
    {
      "oauth2": [
        "AFC_API_Access"
      ]
    },
    {
      "bearer": [
        "AFC_API_Access"
      ]
    }
  ],
  "x-sap-shortText": "Defines how a system or application can integrate with the SAP Task Center Service.",
  "tags": [
    {
      "name": "Task Provider SPI"
    },
    {
      "name": "Task Attachments"
    },
    {
      "name": "Task Comments"
    },
    {
      "name": "Task Provider Configuration API"
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Retrieve all tasks updated",
        "description": "Retrieve all tasks updated after a certain point in time",
        "operationId": "provider_getTasks",
        "parameters": [
          {
            "name": "modifiedAfter",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "utc"
            }
          },
          {
            "name": "lastId",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns matching tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tasks"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/tasks/{taskUrn}": {
      "get": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Retrieve a single task",
        "operationId": "provider_getTask",
        "parameters": [
          {
            "name": "taskUrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/tasks/{taskUrn}/response": {
      "post": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Respond to a task",
        "operationId": "provider_storeTaskResponse",
        "parameters": [
          {
            "name": "taskUrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Response"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task responded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "202": {
            "description": "Accepted asynchronously"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/tasks/{taskUrn}/action": {
      "post": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Execute an action",
        "operationId": "provider_storeTaskAction",
        "parameters": [
          {
            "name": "taskUrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action executed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/taskDefinitions": {
      "get": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Retrieve all task definitions",
        "operationId": "provider_getTaskDefinitions",
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "$skip",
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns task definitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDefinitions"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Introspect technical capabilities",
        "operationId": "provider_getCapabilities",
        "responses": {
          "200": {
            "description": "Returns capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/bulkOperation": {
      "post": {
        "tags": [
          "Task Provider SPI"
        ],
        "summary": "Execute Mass Operation",
        "operationId": "provider_storeTasksOperations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkOperationEntities"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "204": {
            "description": "Accepted"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "urn": {
            "type": "string"
          },
          "applicationId": {
            "type": "string"
          },
          "applicationInstanceId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "localId": {
            "type": "string"
          },
          "definitionId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY",
              "RESERVED",
              "IN_PROGRESS",
              "FOR_RESUBMISSION",
              "INACTIVE",
              "COMPLETED",
              "CANCELED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "enum": [
              "VERY_HIGH",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "processor": {
            "type": "string",
            "nullable": true
          },
          "uiLink": {
            "type": "string"
          },
          "subject": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalizedText"
            }
          }
        }
      },
      "Tasks": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "TaskDefinition": {
        "type": "object",
        "properties": {
          "urn": {
            "type": "string"
          },
          "applicationId": {
            "type": "string"
          },
          "applicationInstanceId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "localId": {
            "type": "string"
          },
          "name": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalizedText"
            }
          }
        }
      },
      "TaskDefinitions": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskDefinition"
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          }
        }
      },
      "Capability": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "LocalizedText": {
        "type": "object",
        "required": [
          "languageCode",
          "text"
        ],
        "properties": {
          "languageCode": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 255
          },
          "isDefault": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Response": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BulkOperationEntity": {
        "type": "object",
        "properties": {
          "urn": {
            "type": "string"
          },
          "entityType": {
            "type": "string",
            "enum": [
              "TASK"
            ]
          },
          "taskOperation": {
            "nullable": true,
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "BulkOperationEntities": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "$ref": "#/components/schemas/BulkOperationEntity"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Incorrect request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Forbidden.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "Too many requests.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "500": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "501": {
        "description": "Not implemented.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Service unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://{subdomain}.authentication.{region}.hana.ondemand.com/oauth/token",
            "scopes": {
              "AFC_API_Access": "AFC API Access"
            }
          }
        }
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}