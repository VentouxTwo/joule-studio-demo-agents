  "components": {
    "schemas": {
      "sapafcsdk.scheduling.ProviderService.Capabilities": {
        "title": "Capabilities",
        "type": "object",
        "properties": {
          "supportsNotification": {"type": "boolean"},
          "applicationUrl": {"type": "string"}
        }
      },
      "sapafcsdk.scheduling.ProviderService.Job": {
        "title": "Job",
        "type": "object",
        "properties": {
          "ID": {"type": "string", "maxLength": 255},
          "name": {"type": "string", "maxLength": 255},
          "referenceID": {"type": "string", "format": "uuid"},
          "version": {"type": "string", "maxLength": 255},
