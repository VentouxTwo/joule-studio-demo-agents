          "link": {"type": "string", "maxLength": 5000},
          "startDateTime": {"type": "string", "format": "date-time"},
          "testRun": {"type": "boolean"},
          "errorOnlyRun": {"type": "boolean"}
        },
        "required": ["ID", "name", "referenceID", "version", "status"]
