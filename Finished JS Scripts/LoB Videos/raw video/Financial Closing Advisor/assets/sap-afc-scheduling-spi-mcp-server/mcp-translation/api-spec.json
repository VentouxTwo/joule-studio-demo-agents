        "responses": {
          "200": {"description": "Retrieved results", "content": {"application/json": {"schema": {"type": "array", "title": "Collection of JobResult", "items": {"$ref": "#/components/schemas/sapafcsdk.scheduling.ProviderService.JobResult"}}}}},
          "400": {"$ref": "#/components/responses/400"},
          "401": {"$ref": "#/components/responses/401"},
          "403": {"$ref": "#/components/responses/403"},
          "500": {"$ref": "#/components/responses/500"}
        },
        "description": "Retrieve results of a job."
